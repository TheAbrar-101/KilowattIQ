    { "id": 3, "title": "Active SSE Client Count", "type": "stat", "expr": "sum(sse_active_clients_count)" },
    { "id": 4, "title": "Telemetry Queue Depth", "type": "stat", "expr": "sum(telemetry_ingestion_queue_depth)" },
    { "id": 5, "title": "API Request Latency (p50 / p95 / p99)", "type": "timeseries" },
    { "id": 6, "title": "Throughput & HTTP Status Breakdown", "type": "timeseries" },
    { "id": 7, "title": "Real-Time SSE Connections & Fan-Out", "type": "timeseries" },
    { "id": 8, "title": "Telemetry Ingestion Rate & Queue Depth", "type": "timeseries" },
    { "id": 9, "title": "Subsystems Health Matrix (/api/v1/health)", "type": "stat" }
  ]
