# ====================================================================
# KilowattIQ Environment Variables Configuration
# ====================================================================

# Supabase Configuration
# IMPORTANT: SUPABASE_URL must be the bare project URL, NOT the REST URL!
# Correct:   https://your-project-ref.supabase.co
# Incorrect: https://your-project-ref.supabase.co/rest/v1
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini AI Advisor (Optional - for AI energy optimization)
GEMINI_API_KEY=your-gemini-api-key

# Fallback & Demo Mode (Set to true to use rich simulated Bangladesh data without database)
USE_MOCK_DATA=false

# MQTT IoT Hardware Broker (Optional - for real ESP32 / PZEM-004T devices)
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_CLIENT_ID=kilowattiq_hub_01
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=kilowattiq/+/telemetry

# Bangladesh Smart Meter & Plug Integrations (Optional)
DESCO_API_ENDPOINT=https://api.desco.org.bd/ami/v1
TUYA_API_KEY=
TUYA_API_SECRET=
