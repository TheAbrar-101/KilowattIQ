# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# Server Configuration
PORT=3000
NODE_ENV=development
USE_MOCK_DATA=false

# Supabase Configuration
SUPABASE_URL="https://your-supabase-project-url.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# IoT Adapter Credentials
TUYA_API_KEY="your-tuya-api-key"
TUYA_API_SECRET="your-tuya-secret"

# IoT MQTT Broker Configuration
MQTT_BROKER_URL="mqtt://broker.hivemq.com:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_CLIENT_ID="kilowattiq_backend_gateway"
MQTT_TELEMETRY_TOPIC="kilowattiq/telemetry/+"

# DESCO API
DESCO_API_ENDPOINT="https://api.desco.org.bd/v1"